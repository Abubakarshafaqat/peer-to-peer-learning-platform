# Server environment — copy to .env and fill in values (Phase 0 scaffold)

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/peer-learning
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=50

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Peer Learning <noreply@example.com>"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ADMIN_SEED_EMAIL=admin@peerlearning.local
ADMIN_SEED_PASSWORD=ChangeMeAdmin1!
ADMIN_SEED_USERNAME=admin

# Frontend default tenant slug when not on a subdomain /t/:slug (Step 2+)
# VITE_DEFAULT_TENANT=alpha
