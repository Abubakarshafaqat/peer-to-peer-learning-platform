{
  "name": "peer-learning-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "seed": "node src/seeds/index.js",
    "seed:tenants": "node src/seeds/seedTenants.js",
    "seed:demo": "node scripts/seedDemo.js",
    "seed:demo:reset": "node scripts/seedDemo.js --reset",
    "smoke:isolation": "node scripts/isolationSmoke.js",
    "migrate:tenants": "node scripts/migrateToMultiTenant.js",
    "migrate:tenants:apply": "node scripts/migrateToMultiTenant.js --apply",
    "migrate:cloudinary": "node scripts/migrateCloudinaryLayout.js",
    "migrate:cloudinary:apply": "node scripts/migrateCloudinaryLayout.js --apply",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
    "test:step9": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand --testPathPattern=step9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "file-type": "^19.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0"
  }
}
